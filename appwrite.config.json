{
  "projectId": "6a71561d000b4f4a06cb",
  "endpoint": "https://fra.cloud.appwrite.io/v1",
  "sites": [
    {
      "$id": "milani-web",
      "name": "Milani Sangha Club",
      "enabled": true,
      "logging": true,
      "framework": "vite",
      "timeout": 30,
      "path": "frontend",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "outputDirectory": "./dist",
      "adapter": "static",
      "fallbackFile": "index.html",
      "specification": "s-1vcpu-512mb",
      "buildRuntime": "node-22"
    }
  ],
  "functions": [
    {
      "$id": "api",
      "name": "Club API",
      "runtime": "node-22",
      "execute": ["any"],
      "enabled": true,
      "logging": true,
      "entrypoint": "functions/api/main.mjs",
      "commands": "npm install && npm --prefix backend install && npm --prefix backend run build",
      "timeout": 30,
      "events": [],
      "schedule": "",
      "path": ".",
      "specification": "s-1vcpu-512mb"
    }
  ]
}
