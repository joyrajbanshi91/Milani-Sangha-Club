{
  "name": "@milani/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/app.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{ts,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "user": "tsx scripts/manage-user.ts",
    "seed:finance": "tsx scripts/seed-finance.ts",
    "provision:appwrite": "tsx scripts/provision-appwrite.ts",
    "backup": "tsx scripts/backup-appwrite.ts",
    "restore": "tsx scripts/restore-appwrite.ts",
    "export:book": "tsx scripts/export-backup.ts",
    "appwrite:check": "tsx scripts/check-appwrite.ts",
    "reset:ledger": "tsx scripts/reset-ledger.ts",
    "reset:members": "tsx scripts/reset-members.ts",
    "members:import": "tsx scripts/import-members.ts"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "node-appwrite": "^27.1.0",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
