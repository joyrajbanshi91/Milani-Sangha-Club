# ---------------------------------------------------------------------------
# Backend environment — copy to .env and fill in.
#
# This file holds SECRETS. Never commit .env, never paste a service account key
# into a chat, a ticket or a document. In production these values come from the
# hosting platform's secret manager, not from a file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5055
APP_VERSION=0.1.0
LOG_LEVEL=debug

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Public URL of the web app — used in emails, receipts and QR verification links.
APP_BASE_URL=http://localhost:5173

# Number of proxy hops to trust for client IP detection (rate limiting).
# 0 locally; 1 behind Firebase Hosting / Cloud Run.
TRUST_PROXY=0

# --- Appwrite ---------------------------------------------------------------
# The backing store and the identity provider. Without these the API falls back
# to the in-memory demo store and demo sign-in, which refuse to run in production.
#
# APPWRITE_API_KEY is a SERVER credential with project-wide reach. It must never
# be given to the browser and never set on an Appwrite Site — only on the API.
# Scopes needed: Databases (read/write) and Users (read/write).
#
# The endpoint is region-specific on Appwrite Cloud, e.g.
# https://syd.cloud.appwrite.io/v1 — copy it from the console.
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=club

# --- Firebase Admin (legacy) -------------------------------------------------
# Only read when the APPWRITE_* values above are absent. Removed in stage 3 of
# the migration; see docs/10-appwrite.md.
#
# Choose ONE of the following.
#
# (a) Point at a downloaded service account key file (recommended locally;
#     keep the file outside the repository):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#
# (b) Supply the credential inline (recommended for CI and hosting secrets).
#     Keep the literal \n sequences in the private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Local emulator suite — set these to use emulators instead of live Firebase.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Email (Phase 13) -------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Milani Sangha Club <no-reply@example.org>"

# --- Club identity ----------------------------------------------------------
CLUB_NAME=Milani Sangha Club
CLUB_UPI_ID=
