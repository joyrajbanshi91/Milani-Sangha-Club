# ---------------------------------------------------------------------------
# Backend environment — copy to .env.
#
# NOTHING HERE IS REQUIRED. With no credentials the API starts, serves the
# embedded demo ledger, offers demo sign-in, warns about it on every boot, and
# answers 503 from /api/v1/health/ready with the variables to set. It does not
# refuse to start — see services/container.ts for why that matters.
#
# This file holds SECRETS once filled in. Never commit .env, and never paste a
# server API key or a service account key into a chat, a ticket or a document.
# For the deployed API these values live on the function in the Appwrite console
# (Functions → api → Settings → Variables), never in a file. See docs/10-appwrite.md.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5055
APP_VERSION=0.1.0
LOG_LEVEL=debug

# Comma-separated list of browser origins allowed to call this API.
# The site and the API have separate domains on Appwrite, so this is load-bearing:
# set it to the site's URL or the browser refuses every response the API sends.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Public URL of the web app — used in emails, receipts and QR verification links.
APP_BASE_URL=http://localhost:5173

# Number of proxy hops to trust for client IP detection (rate limiting).
# 0 locally; 1 for the deployed function. Getting this wrong degrades rate limiting:
# without it req.ip is undefined in a function and the limiter falls back to
# x-forwarded-for — coarser than the real thing.
TRUST_PROXY=0

# --- Appwrite — the recommended store ----------------------------------------
# Set all three, or none. The backing store and the identity provider.
#
# APPWRITE_API_KEY is a SERVER credential with project-wide reach that bypasses
# every permission check. It must never reach the browser: set it on the API
# function, never as a build variable on the site.
# Scopes needed: Databases (read/write) and Users (read/write).
#
# The endpoint is region-specific on Appwrite Cloud, e.g.
# https://fra.cloud.appwrite.io/v1 — copy it from the console rather than
# guessing. Setup: docs/10-appwrite.md
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=club

# --- Firebase Admin — the alternative store ----------------------------------
# Only read when the APPWRITE_* values above are absent, so a deployment carrying
# stale values here cannot quietly keep writing the ledger to Firestore.
#
# Retained rather than removed: it is a working alternative for a club that
# already has a Firebase project, and firebase/firestore.rules describes the
# access model for that case.
#
# Choose ONE of the following.
#
# (a) Point at a downloaded service account key file (simplest locally; keep the
#     file outside the repository):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#
# (b) Supply the credential inline. This is the form to use for the deployed
#     function, which has no filesystem to mount a key file onto. Keep the literal \n
#     sequences in the private key — the code converts them back.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Local emulator suite — set these to use emulators instead of live Firebase.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Email ------------------------------------------------------------------
# Needed only for the website's contact form. Without these the form tells visitors
# to write to the address on the page instead, which is honest and costs nothing.
#
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER is the full address, and
# SMTP_PASSWORD is a 16-character APP PASSWORD from
# https://myaccount.google.com/apppasswords — never the account password, and it
# requires 2-step verification on that account. See docs/11 § 12.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="New Barrackpore Milani Sangha Club <no-reply@example.org>"

# Where the contact form sends enquiries. Unset, they go to SMTP_USER.
# Keep it the same as club.contact.email in frontend/src/content/site.ts.
CONTACT_TO=

# --- Club identity ----------------------------------------------------------
CLUB_NAME=New Barrackpore Milani Sangha Club
CLUB_UPI_ID=

# Printed under the club's name on receipts and statements — the documents that
# leave the building. Both optional: unset, the documents show the name alone.
# Keep them in step with section 1 of frontend/src/content/site.ts.
CLUB_ADDRESS=
CLUB_REGISTRATION_NUMBER=
