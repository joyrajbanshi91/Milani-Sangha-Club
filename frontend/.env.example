# ---------------------------------------------------------------------------
# Frontend environment — copy to .env.local and fill in.
#
# Everything prefixed VITE_ is compiled into the browser bundle and is PUBLIC.
# The Appwrite endpoint and project id are designed to be public; access is
# controlled by sessions and table permissions, not by hiding these values.
# Never put an Appwrite API key, SMTP password or other secret in this file —
# the API key is a server credential and belongs only in backend/.env.
# ---------------------------------------------------------------------------

# Appwrite project (Appwrite console → your project → Settings)
# The endpoint is region-specific on Appwrite Cloud, e.g.
# https://syd.cloud.appwrite.io/v1 — copy it from the console rather than
# guessing. Defaults to https://cloud.appwrite.io/v1 if unset.
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=

# Backend REST API. Keep the /api prefix: in development the Vite dev server
# proxies /api to DEV_API_PROXY. In production this is the deployed API's URL —
# an Appwrite Function has its own domain, so this is usually absolute there.
VITE_API_BASE_URL=/api/v1

# Club identity and contact details shown in the UI
VITE_CLUB_NAME=Milani Sangha Club
VITE_CLUB_UPI_ID=
VITE_SUPPORT_EMAIL=

# ---------------------------------------------------------------------------
# Read by vite.config.ts only. Deliberately NOT prefixed with VITE_, because
# Vite exposes every VITE_ variable to the browser bundle — including ones no
# component references.
# ---------------------------------------------------------------------------
DEV_API_PROXY=http://localhost:5055
