# ---------------------------------------------------------------------------
# Frontend environment — copy to .env.local and fill in.
#
# Everything prefixed VITE_ is compiled into the browser bundle and is PUBLIC.
# Firebase web config is designed to be public; access is controlled by
# security rules and Auth, not by hiding these values. Never put a service
# account key, SMTP password or API secret in this file.
# ---------------------------------------------------------------------------

# Firebase web app config (Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Analytics, and Web Push (Cloud Messaging → Web configuration)
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=

# Backend REST API. Keep the /api prefix: in development the Vite dev server
# proxies /api to DEV_API_PROXY; in production Firebase Hosting rewrites
# /api to the deployed Express service.
VITE_API_BASE_URL=/api/v1

# Point the app at the Firebase emulator suite instead of live services.
VITE_USE_FIREBASE_EMULATORS=false

# Club identity and contact details shown in the UI
VITE_CLUB_NAME=Milani Sangha Club
VITE_CLUB_UPI_ID=
VITE_SUPPORT_EMAIL=

# ---------------------------------------------------------------------------
# Read by vite.config.ts only. Deliberately NOT prefixed with VITE_, because
# Vite exposes every VITE_ variable to the browser bundle — including ones no
# component references.
# ---------------------------------------------------------------------------
DEV_API_PROXY=http://localhost:5055
