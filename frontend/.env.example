# ---------------------------------------------------------------------------
# Frontend environment — copy to .env.local.
#
# NOTHING HERE IS REQUIRED. Every value has a default in src/config/env.ts, and
# the app builds and runs with this file absent entirely. That is what makes a
# first deploy to Netlify a push rather than a configuration exercise.
#
# Everything prefixed VITE_ is compiled into the browser bundle and is PUBLIC —
# anyone can read it with DevTools. The Appwrite endpoint and project id are
# designed to be public; access is decided by the caller's session and by table
# permissions, not by hiding these. Never put an Appwrite API key, a service
# account, an SMTP password or any other secret here: the API key is a server
# credential and belongs only in backend/.env and in Netlify's Functions scope.
# ---------------------------------------------------------------------------

# --- Appwrite (optional) -----------------------------------------------------
# Leave both blank to use demo sign-in: four fixed accounts, no passwords, no
# real data. That is a working state, not an error — the login page lists them.
#
# Set them to use a real Appwrite project. The endpoint is region-specific on
# Appwrite Cloud, e.g. https://fra.cloud.appwrite.io/v1 — copy it from the
# console rather than guessing, because a wrong region looks exactly like a wrong
# project id. Defaults to https://cloud.appwrite.io/v1 when blank.
#
# Setup: docs/10-appwrite.md
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=

# --- The API -----------------------------------------------------------------
# Keep it relative. In development the Vite dev server proxies /api to
# DEV_API_PROXY below; in production the redirect in netlify.toml sends it to the
# function on the site's own origin, so CORS is never exercised.
VITE_API_BASE_URL=/api/v1

# --- Club identity shown in the UI -------------------------------------------
VITE_CLUB_NAME=Milani Sangha Club
VITE_CLUB_UPI_ID=
VITE_SUPPORT_EMAIL=

# ---------------------------------------------------------------------------
# Read by vite.config.ts only. Deliberately NOT prefixed with VITE_, because
# Vite exposes every VITE_ variable to the browser bundle — including ones no
# component references.
# ---------------------------------------------------------------------------
DEV_API_PROXY=http://localhost:5055
