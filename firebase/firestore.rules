rules_version = '2';

// ---------------------------------------------------------------------------
// Milani Sangha Club — Firestore security rules
//
// The default is still deny. Collections are opened one at a time, and the
// finance collections are opened for READING ONLY, to office bearers only.
//
// Why no client writes anywhere in finance: every financial change has to pass
// the two-person rule, allocate a gapless reference number and write an audit
// entry. None of that can be expressed in a security rule, so all writes go
// through the Express API using the Admin SDK, which bypasses these rules. If a
// client could write here it would be a way around the approval requirement.
//
// These rules are the second lock. The API enforces the same boundary in
// middleware/auth.ts. A member is refused twice, independently.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // The role lives in a custom claim, set only by the server. A signed-in user
    // with no claim is treated as an ordinary member rather than assumed upwards.
    function role() {
      return isSignedIn() ? (request.auth.token.role is string ? request.auth.token.role : 'member') : 'visitor';
    }

    function isOfficer() {
      return role() in ['treasurer', 'secretary', 'president', 'administrator'];
    }

    function isAdmin() {
      return role() == 'administrator';
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // -----------------------------------------------------------------------
    // Finance — office bearers may read; nobody may write from a client
    // -----------------------------------------------------------------------

    match /finance_funds/{fundId} {
      allow read: if isOfficer();
      allow write: if false;
    }

    match /finance_categories/{categoryId} {
      allow read: if isOfficer();
      allow write: if false;
    }

    match /finance_transactions/{transactionId} {
      allow read: if isOfficer();
      allow write: if false;
    }

    match /finance_approvals/{approvalId} {
      allow read: if isOfficer();
      allow write: if false;
    }

    match /finance/{document=**} {
      allow read: if isOfficer();
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Audit log — readable by administrators for review, never writable and
    // never deletable by anyone. An audit trail that can be edited is not one.
    // -----------------------------------------------------------------------

    match /audit_logs/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Members — a member may read their own record; officers may read all.
    // Writes go through the API so that changes are recorded and, where the
    // club requires it, approved.
    // -----------------------------------------------------------------------

    match /members/{uid} {
      allow read: if isSelf(uid) || isOfficer();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isOfficer();
      allow write: if false;
    }

    // A member's own membership payments and receipts. Deliberately scoped by
    // the member's own uid: one member must not be able to read another's
    // payment history.
    match /payments/{paymentId} {
      allow read: if isOfficer() || (isSignedIn() && resource.data.memberUid == request.auth.uid);
      allow write: if false;
    }

    match /receipts/{receiptId} {
      allow read: if isOfficer() || (isSignedIn() && resource.data.memberUid == request.auth.uid);
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Everything else stays closed until its own phase opens it explicitly,
    // with its own tests.
    // -----------------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
