rules_version = '2';

// ---------------------------------------------------------------------------
// Milani Sangha Club — Cloud Storage security rules
//
// PHASE 1 BASELINE: deny every read and write.
//
// Storage paths are introduced with the features that own them:
//   gallery/{albumId}/…      images and videos      (Phase 10)
//   documents/{docId}/…      constitution, minutes  (Phase 5)
//   members/{uid}/photo      profile photographs    (Phase 6)
//   receipts/{receiptId}.pdf generated receipts     (Phase 8, backend-written)
//
// Every path opened later must constrain contentType and size — an
// unconstrained upload path is a file-hosting service for strangers.
// ---------------------------------------------------------------------------

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
